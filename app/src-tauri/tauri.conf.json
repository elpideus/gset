{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GSet",
  "mainBinaryName": "gset-app",
  "version": "0.1.2",
  "identifier": "io.github.elpideus.gset",
  "build": {
    "beforeDevCommand": "node ../scripts/sidecar.mjs && pnpm dev",
    "beforeBuildCommand": "node ../scripts/sidecar.mjs && pnpm build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GSet",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "visible": false,
        "backgroundColor": "#161616"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: art: http://art.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Game",
    "shortDescription": "Game launch settings for Linux",
    "longDescription": "One launch option for every Steam game: GSet starts each game with its settings (Gamescope, MangoHud, graphics API, DLSS, frame caps, presets per screen) and gets out of the way.",
    "publisher": "The GSet contributors",
    "copyright": "Copyright 2026 The GSet contributors",
    "license": "GPL-3.0-or-later",
    "externalBin": [
      "binaries/gset"
    ],
    "linux": {
      "deb": {
        "section": "games",
        "recommends": [
          "mangohud",
          "gamescope"
        ]
      },
      "rpm": {
        "recommends": [
          "mangohud",
          "gamescope"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMTkxQzhDQkE4MEIzMUEKUldRYXM0QzZqQndaWHJYWjUxRlIrWXRsSGVZMGNpY0l4dEFoQS9JS1VUdThhZHZGVEpCK3Z0dWMK",
      "endpoints": [
        "https://github.com/elpideus/gset/releases/latest/download/latest.json"
      ]
    }
  }
}
