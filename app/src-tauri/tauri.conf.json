{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GSet",
  "mainBinaryName": "gset-app",
  "version": "0.1.0",
  "identifier": "io.github.elpideus.gset",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GSet",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "visible": false,
        "backgroundColor": "#161616"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: art: http://art.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Game",
    "shortDescription": "Game launch settings for Linux",
    "longDescription": "One launch option for every Steam game: GSet starts each game with its settings (Gamescope, MangoHud, graphics API, DLSS, frame caps, presets per screen) and gets out of the way.",
    "publisher": "The GSet contributors",
    "copyright": "Copyright 2026 The GSet contributors",
    "license": "GPL-3.0-or-later"
  }
}
